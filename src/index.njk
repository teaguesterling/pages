---
layout: base.njk
---

{# Recent updates -- extension releases from stats.json and notes from src/updates/; /updates/ and feed.xml list them all #}
{% set updates = collections.updates | recentUpdates(5, true) %}
{% if updates.length %}
<section class="category recent-updates" id="recent-updates">
  <header class="category-header">
    <h2>Recent updates</h2>
    <p>The latest releases of the DuckDB extensions, and notes on what changed. <a href="{{ '/updates/' | url }}">All updates</a> · <a href="{{ '/feed.xml' | url }}">feed</a>.</p>
  </header>
  {% include "updates-list.njk" %}
</section>
{% endif %}

{# One card per area; each area is a page made by area.njk #}
<section class="category" id="areas">
  <div class="area-grid">
    {% for area in projects.areas %}
    <a class="area-card" href="{{ ('/' + area.key + '/') | url }}">
      <h2 class="area-title">{{ area.title }}</h2>
      <p class="area-description">{{ area.description }}</p>
      <span class="area-count">{{ area.categories | countProjects(projects.categories) }} {{ "entries" if area.key == "spack" else "projects" }}</span>
    </a>
    {% endfor %}
  </div>
</section>
